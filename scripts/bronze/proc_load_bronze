/*
Loads bronze tables with contents from the datasets.
Change paths of files before use.

*/
create or replace procedure bronze.load_bronze() 
language plpgsql
as $$
begin
	
 	RAISE NOTICE 'Starting Bronze Layer Truncating and Data Load in 6 tables...';
	truncate table bronze.crm_cust_info;
	
	copy bronze.crm_cust_info 
	FROM 'C:\Users\Public\Documents\source_crm/cust_info.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');

	truncate table bronze.crm_prd_info;
	
	copy bronze.crm_prd_info 
	FROM 'C:\Users\Public\Documents\source_crm/prd_info.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');
	
	truncate table bronze.crm_sales_details;
	
	copy bronze.crm_sales_details 
	FROM 'C:\Users\Public\Documents\source_crm/sales_details.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');
	
	truncate table bronze.erp_cust_az12;
	
	copy bronze.erp_cust_az12
	FROM 'C:\Users\Public\Documents\source_erp/cust_az12.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');
	
	truncate table bronze.erp_loc_a101;
	
	copy bronze.erp_loc_a101
	FROM 'C:\Users\Public\Documents\source_erp/loc_a101.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');
	
	truncate table bronze.erp_px_cat_g1v2;
	
	copy bronze.erp_px_cat_g1v2
	FROM 'C:\Users\Public\Documents\source_erp/px_cat_g1v2.csv' 
	WITH (
	FORMAT csv,
	HEADER true,
	DELIMITER ',');
	RAISE NOTICE 'Finished Bronze Layer Data Load!';

exception
	when others then
	raise notice 'Error occured during loading bronze layer';
	raise notice 'Error Message: %', SQLERRM;
	
end;
$$
